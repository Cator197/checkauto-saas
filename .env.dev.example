DEBUG=true
SECRET_KEY=dev-secret-key-change-me

# Banco de dados via dj-database-url (host é o service "db" do docker-compose)
DATABASE_URL=postgres://checkauto:checkauto@db:5432/checkauto

# Hosts liberados em dev
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Callback do Google Drive em dev
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/api/drive/oauth2/callback/
